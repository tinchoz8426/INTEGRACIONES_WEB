          "name": "GET Listar turnos (/turnos)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code es 200', () => pm.expect(pm.response.code).to.eql(200));",
                  "",
                  "pm.test('Respuesta es un arreglo', () => {",
                  "  pm.expect(pm.response.json()).to.be.an('array');",
                  "});",
                  "",
                  "pm.test('Cada turno tiene el esquema JSON válido', () => {",
                  "  const schema = {",
                  "    type: 'array',",
                  "    items: {",
                  "      type: 'object',",
                  "      required: ['id','paciente','documento','especialidad','fecha','hora','confirmado'],",
                  "      properties: {",
                  "        id: { type: 'number' },",
                  "        paciente: { type: 'string' },",
                  "        documento: { type: 'string' },",
                  "        especialidad: { type: 'string' },",
                  "        fecha: { type: 'string' },",
                  "        hora: { type: 'string' },",
                  "        confirmado: { type: 'boolean' },",
                  "        medicoId: { type: 'number' },",
                  "        observaciones: { type: ['string','null'] }",
                  "      }",
                  "    }",
                  "  };",
                  "  pm.response.to.have.jsonSchema(schema);",
                  "});",
                  "",
                  "pm.test('Especialidades en Title Case (PascalCase)', () => {",
                  "  const regex = /^[A-ZÁÉÍÓÚÑ][a-záéíóúñ]+(?:\\s[A-ZÁÉÍÓÚÑ][a-záéíóúñ]+)*$/;",
                  "  pm.response.json().forEach((t) => pm.expect(t.especialidad).to.match(regex));",
                  "});"
                ]
              }
            }
          ],
